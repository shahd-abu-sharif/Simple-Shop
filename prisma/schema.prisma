generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  MERCHANT
}

enum OrderStatus {
  PENDING
  DELIVERED
}

enum TransactionType {
  PAYMENT
  REFUND
}

enum ReturnStatus {
  PICKED_UP
  REFUND
  PENDING
}

model User {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  orders       Order[]
  transactions UserTransaction[]
  // products     Product[]         @relation("MerchantProducts")
  products     Product[]

  @@index([name], map: "users_name_index")
  @@map("users")
}

model Order {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt      @map("user_id") @db.UnsignedBigInt
  orderStatus OrderStatus @map("order_status")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id])
  oederProducts OrderProduct[]
  transactions  UserTransaction[]
  orderReturns  OrderReturn[]

  @@map("orders")
}

model Product {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name        String  @db.VarChar(255)
  description String? @db.Text
  imageUrl    String  @map("image_url") @db.VarChar(512)
  price       Decimal @db.Decimal(8, 2)
  merchantId  BigInt  @db.UnsignedBigInt

  merchant      User           @relation(fields: [merchantId], references: [id])
  orderProducts OrderProduct[]
  returned      ReturnedItem[]

  @@map("products")
}

//////////////////////////////////////
// JOIN TABLES
//////////////////////////////////////

model OrderProduct {
  orderId      BigInt  @db.UnsignedBigInt
  productId    BigInt  @db.UnsignedBigInt
  pricePerItem Decimal @db.Decimal(10, 2)
  totalQty     Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
  @@map("order_product")
}

//////////////////////////////////////
// RETURNS
//////////////////////////////////////

model OrderReturn {
  id        BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt       @db.UnsignedBigInt
  status    ReturnStatus
  createdAt DateTime     @default(now())

  order            Order             @relation(fields: [orderId], references: [id])
  items            ReturnedItem[]
  userTransactions UserTransaction[]

  @@map("order_returns")
}

model ReturnedItem {
  orderReturnId BigInt @map("order_return_id") @db.UnsignedBigInt
  productId     BigInt @map("product_id") @db.UnsignedBigInt
  qty           Int    @db.UnsignedInt

  orderReturn OrderReturn @relation(fields: [orderReturnId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@id([orderReturnId, productId])
  @@map("returned_items")
}

//////////////////////////////////////
// TRANSACTIONS
//////////////////////////////////////

model UserTransaction {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  amount        Decimal         @db.Decimal(8, 2)
  userId        BigInt          @map("user_id") @db.UnsignedBigInt
  orderId       BigInt          @map("order_id") @db.UnsignedBigInt
  orderReturnId BigInt?         @map("order_return_id") @db.UnsignedBigInt
  type          TransactionType
  // paymentMethod PaymentMethod
  createdAt     DateTime        @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])
  orderReturn OrderReturn? @relation(fields: [orderReturnId], references: [id])

  @@map("user_transactions")
}
